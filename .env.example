OBSIDIAN_RAG_VAULT_PATH=/path/to/your/vault

# A model tag you've already pulled locally: `ollama pull llama3.2:3b`
# A bigger model (e.g. llama3.1, 8B) gives better answers but needs ~5GB+ free RAM while
# loaded and is much slower on constrained machines — see README's hardware note.
OBSIDIAN_RAG_LLM_MODEL=llama3.2:3b
OBSIDIAN_RAG_LLM_MAX_TOKENS=1024

# Optional: defaults to the standard local Ollama port.
# OBSIDIAN_RAG_OLLAMA_BASE_URL=http://localhost:11434
